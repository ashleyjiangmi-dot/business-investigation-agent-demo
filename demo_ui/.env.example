# 复制为 .env.local 使用；Next.js 自动加载，仅在服务端读取，不向浏览器暴露。
# 模板不放真实凭据。Agent 服务的 TOOL_SERVER_URL / DIAG_TOOLS_API_KEY
# 在 Agent 服务端配置，见 ../agents_oagent/。

# Agent 服务基址（调用 POST {OAGENT_SERVING_URL}/v1/oagent/run）
OAGENT_SERVING_URL=http://127.0.0.1:8327

# 可选：入口字段定义路径，默认 ../core/data/entry_fields.json
OAGENT_GRAPH_PATH=

# 可选：原始流与下发流记录目录，默认 ../agents_oagent/evidence/demo_ui/runs/
OAGENT_RAW_DIR=

# 记录开关：默认关闭，设为 1 时保存原始流与下发流；正常演示无需开启。
OAGENT_RAW_DUMP=0
